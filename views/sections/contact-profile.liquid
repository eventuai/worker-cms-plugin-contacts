<div class="min-w-0">
  <header class="mb-6">
    <a href="{{ backHref }}" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-800">
      <svg class="h-4 w-4" aria-hidden="true"><use href="{{ iconHrefPrefix }}#arrow-left"></use></svg>
      Contacts
    </a>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <h1 class="min-w-0 break-words text-3xl font-bold text-gray-900">{{ name }}</h1>
      {% if editHref != blank %}
        <a href="{{ editHref }}" title="Edit contact" aria-label="Edit contact" class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white hover:bg-indigo-700">
          <svg class="h-4 w-4" aria-hidden="true"><use href="{{ iconHrefPrefix }}#pencil-square"></use></svg>
          <span class="hidden lg:inline">Edit contact</span>
        </a>
      {% endif %}
    </div>
  </header>

  <div class="grid gap-6 {% if groups.size > 0 %}{% if cards.size > 0 or tagGroups.size > 0 %}lg:grid-cols-3{% endif %}{% endif %}">
    {% if cards.size > 0 or tagGroups.size > 0 %}
      <aside class="min-w-0 space-y-4">
        {% if tagGroups.size > 0 %}
          <section class="rounded-xl border border-gray-200 bg-white p-4">
            <h2 class="mb-3 text-lg font-semibold text-gray-900">Contact tags</h2>
            <dl class="space-y-3">
              {% for group in tagGroups %}
                <div>
                  <dt class="text-sm font-medium text-gray-700">{{ group.label }}</dt>
                  <dd class="mt-1 flex flex-wrap gap-2">
                    {% for tag in group.tags %}<span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">{{ tag }}</span>{% endfor %}
                  </dd>
                </div>
              {% endfor %}
            </dl>
          </section>
        {% endif %}
        {% if cards.size > 0 %}
          <section class="rounded-xl border border-gray-200 bg-white p-4">
            <h2 class="mb-3 text-lg font-semibold text-gray-900">{% if cards.size == 1 %}Business card{% else %}Business cards{% endif %}</h2>
            <div class="space-y-3">
              {% for card in cards %}
                <a class="block" href="{{ card }}" target="_blank" rel="noopener noreferrer">
                  <img class="w-full rounded-lg" src="{{ card }}" alt="Scanned business card{% if cards.size > 1 %} {{ forloop.index }}{% endif %}" loading="lazy" referrerpolicy="no-referrer">
                </a>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </aside>
    {% endif %}
    {% if groups.size > 0 %}
      <div class="min-w-0 space-y-4 {% if cards.size > 0 or tagGroups.size > 0 %}lg:col-span-2{% endif %}">
        {% for group in groups %}
          <section class="rounded-xl border border-gray-200 bg-white p-4 sm:p-6">
            <h2 class="mb-3 text-lg font-semibold text-gray-900">{{ group.label }}</h2>
            <div class="divide-y divide-gray-100">
              {% for row in group.rows %}
                <dl class="grid gap-3 py-3 sm:grid-cols-2">
                  {% for field in row %}
                    <div class="min-w-0">
                      <dt class="text-sm font-medium text-gray-600">{{ field.label }}</dt>
                      {% for value in field.values %}
                        <dd class="mt-1 whitespace-pre-wrap break-words text-sm text-gray-900">{% if field.isDate %}{{ value | l10n_date: dateOptions }}{% elsif field.isDateTime %}{{ value | l10n_date }}{% else %}{{ value }}{% endif %}</dd>
                      {% endfor %}
                    </div>
                  {% endfor %}
                </dl>
              {% endfor %}
            </div>
          </section>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
